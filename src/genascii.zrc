#!/usr/bin/env zrc
# only run this script on ascii system
cd `{dirname $1}

> asciiwarn.hpp eval {
	echo {
#ifndef ASCIIWARN_HPP
#define ASCIIWARN_HPP
#undef MSG
#define MSG "Metamath character set not respected"
	}
	for {set c = [ord '!']} {$c <= [ord '~']} {inc c} {
		set cl = [chr $c]
		set cl2 = $cl
		if {$c == [ord \'] || $c == [ord \\]} {
			set cl2 = \\$cl
		}
		if {$c >= [ord 'A'] && $c <= [ord 'Z']
		|| [str $cl =~ {^(a|c|d|e|f|p|v|\{|\}|\(|\)|\$|\[|\]|\.|\=|\?)$}]} {
			printf "static_assert('%s' == 0x%X, MSG);\n" $cl2 $c
		} else {
			if {$c == [ord '-'] || $c == [ord '_']} {
				printf "static_assert('%s' == 0x%X || '%s' == 0x%X, MSG);\n" \
					$cl2 [ord '-'] $cl2 [ord '_']
			} else {
				if {$c >= [ord 'a'] && $c <= [ord 'z']} {
					set m = [ord 'a'] M = [ord 'z']
				} else if {$c >= [ord '0'] && $c <= [ord '9']} {
					set m = [ord '0'] M = [ord '9']
				} else {
					set m = [ord '!'] M = [ord '~']
				}
				printf "static_assert(0x%X <= '%s' && '%s' <= 0x%X, MSG);\n" \
					$m $cl2 $cl2 $M
			}
		}
	}
	echo {
#undef MSG
#endif // ASCIIWARN_HPP
	}
}
exit 0
